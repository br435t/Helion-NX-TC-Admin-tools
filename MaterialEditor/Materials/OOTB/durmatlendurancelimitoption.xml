<Property name=""
          neutralName="EnduranceLimitOption"
          valueType="enum"
          valueSubtype="&enumRadioButton;"
          valueChoices="&Choice;Cycles=0&Choice;Stress=1&Choice;Strain=2"
          Dimensions="&MeasureUnitLess;">
    <DefaultValue value="0"/>
    <LowerBound value="0"
                inclusive="true"/>
    <UpperBound value="2"
                inclusive="true"/>
</Property>

<Property name="Number of Cycles"
          neutralName="NumberCycles"
          valueType="scalarField"
          Dimensions="&MeasureUnitLess;"
          parentProperty="EnduranceLimitOption"
          parentPropertyValToBeSensitive="0"
          propertyVisibleOrSensitive="sensitive">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="false"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
  <FieldDefn nDomains="2">
    <Domain type="&DomainConstant;"/>
    <Domain type="&DomainTemperature;"/>
  </FieldDefn>
</Property>


<Property name="Endurance Stress Amplitude"
          neutralName="StressAmplitude"
          valueType="scalarField"
          Dimensions="&MeasureStress;"
          parentProperty="EnduranceLimitOption"
          parentPropertyValToBeSensitive="1"
          propertyVisibleOrSensitive="sensitive">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
  <FieldDefn nDomains="2">
    <Domain type="&DomainConstant;"/>
    <Domain type="&DomainTemperature;"/>
  </FieldDefn>
</Property>


<Property name="Endurance Strain Amplitude"
          neutralName="StrainAmplitude"
          valueType="scalarField"
          Dimensions="&MeasureStrain;"
          parentProperty="EnduranceLimitOption"
          parentPropertyValToBeSensitive="2"
          propertyVisibleOrSensitive="sensitive">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
  <FieldDefn nDomains="2">
    <Domain type="&DomainConstant;"/>
    <Domain type="&DomainTemperature;"/>
  </FieldDefn>
</Property>

