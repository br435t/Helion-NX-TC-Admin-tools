<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE MaterialViews SYSTEM "physmatlview.dtd"
[
    <!ENTITY coatingscommon SYSTEM "coatings.mpvx">
    <!ENTITY formabilitycommon SYSTEM "formability.mpvx">
    <!ENTITY visualizationcommon SYSTEM "visualization.mpvx">
    <!ENTITY pedestrianprops SYSTEM "pedestrianprops.mpvx">
    <!ENTITY matlcommon SYSTEM "matl_common.mpvx">
    <!ENTITY matlisocommon SYSTEM "matl_isocommon.mpvx">
    <!ENTITY nxnisocommon SYSTEM "nxn_isocommon.mpvx">
    <!ENTITY nxnorthocommon SYSTEM "nxn_orthocommon.mpvx">
    <!ENTITY nxnanisocommon SYSTEM "nxn_anisocommon.mpvx">
    <!ENTITY nxnMat1 SYSTEM "nxn_mat1props.mpvx">
    <!ENTITY nxnMatt1 SYSTEM "nxn_matt1props.mpvx">
    <!ENTITY nxnMat1f SYSTEM "nxn_mat1fprops.mpvx">
    <!ENTITY nxnMat2 SYSTEM "nxn_mat2props.mpvx">
    <!ENTITY nxnMat3 SYSTEM "nxn_mat3props.mpvx">
    <!ENTITY nxnMat4 SYSTEM "nxn_mat4props.mpvx">
    <!ENTITY nxnMat5 SYSTEM "nxn_mat5props.mpvx">
    <!ENTITY nxnMat8 SYSTEM "nxn_mat8props.mpvx">
    <!ENTITY nxnMat9 SYSTEM "nxn_mat9props.mpvx">
    <!ENTITY nxnMat10 SYSTEM "nxn_mat10props.mpvx">
    <!ENTITY nxnMats1 SYSTEM "nxn_mats1props.mpvx">
    <!ENTITY nxnMatsr SYSTEM "nxn_matsrprops.mpvx">
    <!ENTITY nxnAcousticsMat10 SYSTEM "nxn_mat10_acousticsprops.mpvx">
    <!ENTITY nxnMat11 SYSTEM "nxn_mat11props.mpvx">
    <!ENTITY nxnMooneyMathe SYSTEM "nxn_mooney_matheprops.mpvx">
    <!ENTITY nxnOgdenMathe SYSTEM "nxn_ogden_matheprops.mpvx">
    <!ENTITY nxnFoamMathe SYSTEM "nxn_foam_matheprops.mpvx">
    <!ENTITY nxnMathp SYSTEM "nxn_mathpprops.mpvx">
    <!ENTITY nxnElasticMatpor SYSTEM "nxn_matporelasticprops.mpvx">
    <!ENTITY nxnMatpor SYSTEM "nxn_matporprops.mpvx">
    <!ENTITY nxnMplas SYSTEM "nxn_mplasprops.mpvx">
    <!ENTITY nxnCreep SYSTEM "nxn_creepprops.mpvx">
    <!ENTITY nxnMatcrp SYSTEM "nxn_matcrpprops.mpvx">
    <!ENTITY nxnMvplas SYSTEM "nxn_mvplasprops.mpvx">

    <!ENTITY abacommon SYSTEM "aba_common.mpvx">
    <!ENTITY abaisocommon SYSTEM "aba_isocommon.mpvx">
    <!ENTITY abaorthocommon SYSTEM "aba_orthocommon.mpvx">
    <!ENTITY abaanisocommon SYSTEM "aba_anisocommon.mpvx">
    <!ENTITY abamooneycommon SYSTEM "aba_mooneycommon.mpvx">
    <!ENTITY abaogdencommon SYSTEM "aba_ogdencommon.mpvx">
    <!ENTITY abalamina SYSTEM "aba_lamina.mpvx">


    <!ENTITY anscommon SYSTEM "ans_common.mpvx">
    <!ENTITY ansisocommon SYSTEM "ans_isocommon.mpvx">
    <!ENTITY ansorthocommon SYSTEM "ans_orthocommon.mpvx">
    <!ENTITY ansanisocommon SYSTEM "ans_anisocommon.mpvx">
    <!ENTITY ansfluidcommon SYSTEM "ans_fluidcommon.mpvx">
    <!ENTITY ansmooneycommon SYSTEM "ans_mooneycommon.mpvx">
    <!ENTITY ansogdencommon SYSTEM "ans_ogdencommon.mpvx">
    <!ENTITY anstbchaboche SYSTEM "ans_tbchaboche.mpvx">



    <!ENTITY samcommon SYSTEM "sam_common.mpvx">
    <!ENTITY samisostructure SYSTEM "sam_isostructure.mpvx">
    <!ENTITY samisothermal SYSTEM "sam_isothermal.mpvx">
    <!ENTITY samorthostructure SYSTEM "sam_orthostructure.mpvx">
    <!ENTITY sambilinearstructure SYSTEM "sam_bilinearstructure.mpvx">
    <!ENTITY samortholineardamagestructure SYSTEM "sam_orthotropiclineardamagestructure.mpvx">
    <!ENTITY samisolineardamagestructure SYSTEM "sam_isotropiclineardamagestructure.mpvx">
    <!ENTITY samorthothermal SYSTEM "sam_orthothermal.mpvx">
    <!ENTITY samanisostructure SYSTEM "sam_anisostructure.mpvx">
    <!--ENTITY samanisothermal SYSTEM "sam_anisothermal.mpvx"-->
    <!ENTITY sammooneycommon SYSTEM "sam_mooneycommon.mpvx">
    <!ENTITY samogdencommon SYSTEM "sam_ogdencommon.mpvx">
    <!ENTITY samfluidcommon SYSTEM "sam_fluidcommon.mpvx">
    <!ENTITY samlaminateortho SYSTEM "sam_laminateortho.mpvx">

    <!ENTITY samcuringstructure SYSTEM "sam_curingstructure.mpvx">
    <!ENTITY samcuringthermal SYSTEM "sam_curingthermal.mpvx">

    <!ENTITY durabilityprops SYSTEM "durabilityprops.mpvx">
    <!ENTITY durabilityiso SYSTEM "durabilityisotropic.mpvx">
    <!ENTITY durabilityortho SYSTEM "durabilityorthotropic.mpvx">
    <!ENTITY durabilitycommon SYSTEM "durabilitycommon.mpvx">
    <!ENTITY durabilitystresslife SYSTEM "durabilitystresslife.mpvx">
    <!ENTITY durabilitystrainlife SYSTEM "durabilitystrainlife.mpvx">
    <!ENTITY durabilityisostrainlimits SYSTEM "durabilityisostrainlimits.mpvx">    

    <!ENTITY infolyticaanisotropiccommon SYSTEM "infolytica_magnet_anisotropic_common.mpvx">
    <!ENTITY infolyticaanisotropicelectric SYSTEM "infolytica_magnet_anisotropic_electric.mpvx">
    <!ENTITY infolyticaanisotropicmagnetic SYSTEM "infolytica_magnet_anisotropic_magnetic.mpvx">
    <!ENTITY infolyticaanisotropicthermal SYSTEM "infolytica_magnet_anisotropic_thermal.mpvx">
    <!ENTITY infolyticaanisotropicmagneto SYSTEM "infolytica_magnet_anisotropic_magnetostriction.mpvx">

    <!ENTITY infolyticaisotropiccommon SYSTEM "infolytica_magnet_isotropic_common.mpvx">
    <!ENTITY infolyticaisotropicelectric SYSTEM "infolytica_magnet_isotropic_electric.mpvx">
    <!ENTITY infolyticaisotropicmagnetic SYSTEM "infolytica_magnet_isotropic_magnetic.mpvx">
    <!ENTITY infolyticaisotropicthermal SYSTEM "infolytica_magnet_isotropic_thermal.mpvx">
    <!ENTITY infolyticaisotropicmagneto SYSTEM "infolytica_magnet_isotropic_magnetostriction.mpvx">

    <!ENTITY idsgalileoisotropiccommon SYSTEM "ids_galileo_isotropic_common.mpvx">
    <!ENTITY idsgalileoisotropic SYSTEM "ids_galileo_isotropic.mpvx">

    <!ENTITY compoundcommon SYSTEM "compoundmaterialcommon.mpvx">

    <!ENTITY lsdynaisocommon SYSTEM "lsdyna_isocommon.mpvx">
    <!ENTITY lsdynabeamdampingfactors SYSTEM "lsdyna_isobeamdampingfactors.mpvx">
    <!ENTITY lsdynaorthocommon SYSTEM "lsdyna_orthocommon.mpvx">
    <!ENTITY lsdynaanisocommon SYSTEM "lsdyna_anisocommon.mpvx">
    <!ENTITY lsdynaplastickinematic SYSTEM "lsdyna_plastickinematic.mpvx">
    <!ENTITY lsdynaviscoelastic SYSTEM "lsdyna_viscoelastic.mpvx">
    <!ENTITY lsdynatrip SYSTEM "lsdyna_trip.mpvx">
    <!ENTITY lsdynamooneyrivlin SYSTEM "lsdyna_mooneyrivlin.mpvx">
    <!ENTITY lsdynacompositedamage SYSTEM "lsdyna_compositedamage.mpvx">
    <!ENTITY lsdynaisocompositelayup SYSTEM "lsdyna_isocompositelayup.mpvx">
    <!ENTITY lsdynaorthocompositelayup SYSTEM "lsdyna_orthocompositelayup.mpvx">
    <!ENTITY lsdynaenhancedcompositedamage SYSTEM "lsdyna_enhancedcompositedamage.mpvx">
    
    <!ENTITY laminateisocommon SYSTEM "laminate_isocommon.mpvx">
    <!ENTITY nastranlaminateiso SYSTEM "nastran_laminateiso.mpvx">
    <!ENTITY lamanisocommon SYSTEM "laminate_anisocommon.mpvx">
    <!ENTITY laminateorthocommon SYSTEM "laminate_orthocommon.mpvx">
    <!ENTITY laminateorthodamage SYSTEM "laminate_orthodamage.mpvx">

]>
<MaterialViews>

    <MaterialView displayName="Design"
                  lookupKey="designViewIso"
                  description="Design View Showing Properties for Mass Calculation"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="base">
        &nxnisocommon;

        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="false"/>
    </MaterialView>

    <MaterialView displayName="Design"
                  lookupKey="designViewIso_compound"
                  description="Design View Showing Properties for Mass Calculation"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="base">
        &nxnisocommon;
        &compoundcommon;

        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="false"/>
    </MaterialView>
    <MaterialView displayName="Coatings"
                  lookupKey="coatings"
                  description="Displays properties used by the Coatings application"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;&Choice;&ViewEnvCoatings;"
                  viewType="addon"
                  parentViews="designViewIso">
        &coatingscommon;

    </MaterialView>
    <MaterialView displayName="Coatings"
                  lookupKey="coatings_compound"
                  description="Displays properties used by the Coatings application"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;&Choice;&ViewEnvCoatings;"
                  viewType="addon"
                  parentViews="designViewIso_compound">
       &coatingscommon;
       &compoundcommon;
      
    </MaterialView>

    <MaterialView displayName="Formability"
                  lookupKey="formability"
                  description="Displays properties used by forming applications"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="addon"
                  parentViews="designViewIso">
        &formabilitycommon;

    </MaterialView>

    <MaterialView displayName="Formability"
                lookupKey="formability_compound"
                description="Displays properties used by forming applications"
                materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                viewType="addon"
                parentViews="designViewIso_compound">
      &formabilitycommon;
      &compoundcommon;

    </MaterialView>
    <MaterialView displayName="Simulation"
                  lookupKey="simulation"
                  description="Displays properties used by simulation applications for designers such as Live Simulation and Topology Optimization"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="addon"
                  parentViews="designViewIso">

        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="false"/>

    <ReferenceProperty neutralName="MassDensityConstant"/>
    <ReferenceProperty neutralName="YoungsModulusConstant"/>
    <ReferenceProperty neutralName="PoissonsRatioConstant"/>

    </MaterialView>
        
    <MaterialView displayName="Simulation"
                lookupKey="simulation_compound"
                description="Displays properties used by simulation applications for designers such as Live Simulation and Topology Optimization"
                materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                viewType="addon"
                parentViews="designViewIso_compound">
      &compoundcommon;

      <ReferenceProperty neutralName="ElasticDependencyControl"
                         valueChoices="&Choice;Constant=3"
                         defaultValue="3"
                         showProp="false"
                         lockProp="false"/>

      <ReferenceProperty neutralName="MassDensityConstant"/>
      <ReferenceProperty neutralName="YoungsModulusConstant"/>
      <ReferenceProperty neutralName="PoissonsRatioConstant"/>

    </MaterialView>
  
    <MaterialView displayName="Visualization"
                  lookupKey="visualization"
                  description="Visualization Studio Material Name, Crosshatch Pattern and Color Picker"
                  materialType="&MaterialTypeISOTROPIC;&Choice;&MaterialTypeANISOTROPIC;&Choice;&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="addon"
                  parentViews="designViewIso&Choice;designView">
        &visualizationcommon;

    </MaterialView>

    <MaterialView displayName="Visualization"
                  lookupKey="visualization_compound"
                  description="Visualization Studio Material Name, Crosshatch Pattern and Color Picker"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="addon"
                  parentViews="designViewIso_compound&Choice;designView">
        &visualizationcommon;
        &compoundcommon;
        
    </MaterialView>  
    
    <MaterialView displayName="Pedestrian"
                  lookupKey="pedestrian"
                  description="Displays properties used by pedestrian protection"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;&Choice;&ViewEnvCoatings;"
                  viewType="addon"
                  parentViews="designViewIso">
        &pedestrianprops;
    </MaterialView>
    <MaterialView displayName="Pedestrian"
                  lookupKey="pedestrian_compound"
                  description="Displays properties used by pedestrian protection"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;&Choice;&ViewEnvCoatings;"
                  viewType="addon"
                  parentViews="designViewIso_compound">
       &compoundcommon;
       &pedestrianprops;
    </MaterialView>    
    
    
    
    
    <MaterialView displayName="Design"
                  lookupKey="designView"
                  description="Design View Showing Properties for Mass Calculation"
                  materialType="&MaterialTypeORTHOTROPIC;&Choice;&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvGeneral;&Choice;&ViewEnvModeling;"
                  viewType="base">
        <ReferenceProperty neutralName="DensityControl"
                           valueChoices="&Choice;Constant or Temperature or Frequency=0"
                           defaultValue="0"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="MassDensity"/>

    </MaterialView>

    <MaterialView displayName="MAT1"
                  lookupKey="mat1"
                  description="Material properties for linear isotropic materials"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;
        &nxnisocommon;
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="false"/>
        &nxnMat1;
    </MaterialView>

    <MaterialView displayName="MAT1"
                  lookupKey="mat1_compound"
                  description="Material properties for linear isotropic materials"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        <ReferencedMatlView lookupKey="mat1"/>
        &compoundcommon;
    </MaterialView>

    <MaterialView displayName="MAT4"
                  lookupKey="mat4"
                  description="Thermal material properties for conductivity, heat capacity, density, dynamic viscosity, heat generation, reference enthalpy, and latent heat associated with a single-phase change"
                  materialType="&MaterialTypeISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;
        &nxnisocommon;
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="false"/>
        &nxnMat4;
    </MaterialView>

    <MaterialView displayName="MAT4"
                  lookupKey="mat4_compound"
                  description="Thermal material properties for conductivity, heat capacity, density, dynamic viscosity, heat generation, reference enthalpy, and latent heat associated with a single-phase change"
                  materialType="&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        <ReferencedMatlView lookupKey="mat4"/>
        &compoundcommon;
    </MaterialView>

    <!-- make the first orthotropic material view since it is the generic material type and MAT3 and MAT8 are specialized versions -->
    <MaterialView displayName="MAT11"
                  lookupKey="mat11"
                  description="Orthotropic material properties for axisymmetric elements, 2D solid elements, 3D solid elements, and 3D solid composite elements"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;

        &nxnorthocommon;
        &nxnMat11;
    </MaterialView>

    <MaterialView displayName="MAT3"
                  lookupKey="mat3"
                  description="Linear orthotropic materials for the axisymmetric elements; the plane strain elements; and the plane stress elements"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;

        &nxnorthocommon;
        &nxnMat3;
    </MaterialView>

    <MaterialView displayName="MAT8"
                  lookupKey="mat8"
                  description="Material property for an orthotropic material for isoparametric shell elements"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;

        &nxnorthocommon;
        &nxnMat8;
    </MaterialView>

    <MaterialView displayName="MAT10"
                  lookupKey="mat10"
                  description="Material properties for fluid or absorber elements in coupled fluid-structural analysis"
                  materialType="&MaterialTypeFLUID;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;

        &nxnMat10;
    </MaterialView>

    <MaterialView displayName="MAT2"
                  lookupKey="mat2"
                  description="Material properties for linear anisotropic materials for two-dimensional elements"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Temperature=0"
                           defaultValue="0"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="AnisotropicElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="true"/>
        &nxnanisocommon;
        &nxnMat2;
    </MaterialView>

    <MaterialView displayName="MAT5"
                  lookupKey="mat5"
                  description="Thermal material properties for anisotropic materials"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;
        <ReferenceProperty neutralName="DensityControl"
                           valueChoices="&Choice;Constant or Temperature or Frequency=0"
                           defaultValue="0"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="MassDensity"/>

        &nxnMat5;
    </MaterialView>

    <MaterialView displayName="MAT9"
                  lookupKey="mat9"
                  description="Material properties for linear, temperature-independent, anisotropic materials for solid isoparametric elements"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="base">
        &matlcommon;
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Temperature=0"
                           defaultValue="0"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="AnisotropicElasticDependencyControl"
                           valueChoices="&Choice;Constant=3"
                           defaultValue="3"
                           showProp="false"
                           lockProp="true"/>
        &nxnanisocommon;
        &nxnMat9;
    </MaterialView>

    <MaterialView displayName="MATT1"
                  lookupKey="matt1"
                  description="Temperature-dependent material properties on MAT1"
                  materialType="&MaterialTypeISOTROPIC;&Choice;&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat1&Choice;mat1_compound">
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Temperature=4"
                           defaultValue="4"
                           showProp="false"
                           lockProp="true"
                           commonProps="replaceAndMerge"
                           mergePropValue="6"/>
        <ReferenceProperty neutralName="CalculateConstantValuesTempDep"/>
        &nxnMatt1;
    </MaterialView>

    <MaterialView displayName="MATT2"
                  lookupKey="matt2"
                  description="Temperature-dependent material properties on MAT2"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat2">
        <ReferenceProperty neutralName="AnisotropicElasticDependencyControl"
                           valueChoices="&Choice;Temperature=4"
                           defaultValue="4"
                           showProp="false"
                           lockProp="true"
                           commonProps="replaceAndMerge"
                           mergePropValue="6"/>
        <ReferenceProperty neutralName="CalculateConstantValuesTempDep"/>
    </MaterialView>

    <MaterialView displayName="MATT3"
                  lookupKey="matt3"
                  description="Temperature-dependent material properties on MAT3"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat3">
    </MaterialView>

    <MaterialView displayName="MATT4"
                  lookupKey="matt4"
                  description="Temperature-dependent material properties on MAT4"
                  materialType="&MaterialTypeISOTROPIC;&Choice;&MaterialTypeCOMPOUNDISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat4&Choice;mat4_compound">
        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Temperature=4"
                           defaultValue="4"
                           showProp="false"
                           lockProp="true"
                           commonProps="replace"/>
        <ReferenceProperty neutralName="CalculateConstantValuesTempDep"/>
    </MaterialView>

    <MaterialView displayName="MATT5"
                  lookupKey="matt5"
                  description="Temperature-dependent material properties on MAT5"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat5">
    </MaterialView>

    <MaterialView displayName="MATT8"
                  lookupKey="matt8"
                  description="Temperature-dependent material properties on MAT8"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat8">
    </MaterialView>

    <MaterialView displayName="MATT9"
                  lookupKey="matt9"
                  description="Temperature-dependent material properties on MAT9"
                  materialType="&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat9">
        <ReferenceProperty neutralName="AnisotropicElasticDependencyControl"
                           valueChoices="&Choice;Temperature=4"
                           defaultValue="4"
                           showProp="false"
                           lockProp="true"
                           commonProps="replaceAndMerge"
                           mergePropValue="6"/>
        <ReferenceProperty neutralName="CalculateConstantValuesTempDep"/>
    </MaterialView>

    <MaterialView displayName="MATT10"
                  lookupKey="matt10"
                  description="Temperature-dependent material properties on MAT10"
                  materialType="&MaterialTypeFLUID;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat10">
        &matlcommon;

        &nxnMat10;
    </MaterialView>

    <MaterialView displayName="MATT11"
                  lookupKey="matt11"
                  description="Temperature-dependent material properties on MAT11"
                  materialType="&MaterialTypeORTHOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvMSCNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat11">
    </MaterialView>

    <MaterialView displayName="MATS1"
                  lookupKey="mats1"
                  description="Stress-dependent material properties for use in applications involving nonlinear materials"
                  materialType="&MaterialTypeISOTROPIC;&Choice;&MaterialTypeCOMPOUNDISOTROPIC;&Choice;&MaterialTypeORTHOTROPIC;&Choice;&MaterialTypeANISOTROPIC;"
                  environments="&ViewEnvSimcenterNastran;&Choice;&ViewEnvSimcenterMultiPhysics;&Choice;&ViewEnvDesignSim;&Choice;&ViewEnvADINANastran;"
                  viewType="addon"
                  parentViews="mat1&Choice;mat1_compound&Choice;mat3&Choice;mat8&Choice;mat11&Choice;mat9"
                  invalidViewCombos="mplas&Choice;mat1f&Choice;mvplas&Choice;mat9f&Choice;mat2f">
        &nxnMats1;
    </MaterialView>

