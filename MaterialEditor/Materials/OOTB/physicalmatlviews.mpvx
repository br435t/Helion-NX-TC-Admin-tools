    <MaterialView displayName="Simcenter Nastran Isotropic"
                  lookupKey="NXNIsotropic"
                  viewID="13"
                  environments="&ViewEnvSimcenterNastran;"
                  visible="false"
                  materialType="&MaterialTypeISOTROPIC;">
        &matlcommon;
        &nxnisocommon;

        <ReferenceProperty neutralName="ElasticDependencyControl"
                           valueChoices="&Choice;Constant=3&Choice;Temperature=4&Choice;Frequency=5&Choice;Frequency and Temperature=6"
                           defaultValue="3"
                           showProp="true"
                           lockProp="false"/>
        <ReferenceProperty neutralName="ReferenceFrequency"/>
        <ReferenceProperty neutralName="CalculateConstantValuesFreqDep"/>
        <ReferenceProperty neutralName="CalculateConstantValuesTempDep"/>

        <ReferenceProperty neutralName="MatlNonlinearityType"
                           valueChoices="&Choice;None=-1;
                                         &Choice;Nonlinear elastic: stress-strain (MATS1/NLELAST)=0;
                                         &Choice;Elastoplastic: stress-total strain (MATS1/PLASTIC)=1;
                                         &Choice;Elastoplastic: stress-plastic strain (MATS1/PLSTRN)=2;
                                         &Choice;Elastoplastic: material (MPLAS)=3;"
                           defaultValue="1"/>

        <ReferenceProperty neutralName="YieldFunctionCriterion"
                           valueChoices="&Choice;von Mises=1&Choice;Tresca=2&Choice;Mohr-Coulomb=3&Choice;Drucker-Prager=4&Choice;Hill by Stress Ratios=7&Choice;Grey Cast Iron=8"
                           defaultValue="1"/>

        <ReferenceProperty neutralName="HardeningRule"
                           valueChoices="&Choice;Isotropic=1;
                                         &Choice;Kinematic=2;
                                         &Choice;Mixed Hardening=3;
                                         &Choice;Sublayer Kinematic=4;
                                         &Choice;Isotropic + Chaboche Kinematic=5;
                                         &Choice;Isotropic Saturated + Chaboche Kinematic=6
                                         &Choice;Isotropic Saturated=7"
                           defaultValue="1"/>

        <ReferenceProperty neutralName="CreepFormulation"
                           valueChoices="&Choice;##397None=0;
                                         &Choice;O.R.N.L viscoplastic material (CREEP/TYPE 111-222)=2;
                                         &Choice;Time Hardening (Norton-Bailey) Power Law (CREEP/TYPE 300)=1;
                                         &Choice;Kelvin-Maxwell, uniaxial creep recovery test, Tabular Input (CREEP/Table)=3;
                                         &Choice;Norton-Bailey in Time or Strain Hardening, Temperature-Dependent (MATCRP/Type 301)=5;
                                         &Choice;Strain Hardening Creep (MVPLAS/Law STRNHARD)=6;
                                         &Choice;Norton Creep (MVPLAS/Law NORTON)=7;
                                         &Choice;Generalized Garofalo Creep (MVPLAS/Law GENGAROF)=8;
                                         &Choice;Norton-Bailey in Time Hardening Creep (MVPLAS/Law TIMEHARD)=9;
                                         &Choice;User Creep (MVPLAS/Law USER + MUCRP on Bulk Data user defined text)=10;"
                           defaultValue="0"/>
        &nxnMat1;
        &nxnMatt1;
        &nxnMat1f;
        &nxnMats1;
        &nxnMatsr;
        &nxnMplas;
        &nxnMat4;
        &nxnCreep;
        &nxnMatcrp;
        &nxnMvplas;
    </MaterialView>

