                   minValue="&valueZero;"
                   minValueInclude="false"
                   requiredInView="true"/>

<ReferenceProperty neutralName="PoissonsRatioTemperature"
                   minValue="&valueZero;"
                   minValueInclude="true"
                   maxValue="&IsotropicPoissonsMaximum;"
                   maxValueInclude="true"
                   requiredInView="true"/>


<ReferenceProperty neutralName="StrainBCurve"
                   minValue="&valueZero;"
                   minValueInclude="true"
                   requiredInView="true"/>

