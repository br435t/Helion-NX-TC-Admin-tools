<Property name=""
          neutralName="PermittivityType"
          valueType="enum"
          valueSubtype="radio"
          valueChoices="&Choice;Linear Permittivity=1&Choice;Nonlinear Permittivity=2"
          parentProperty="ElectromagneticFrequency"
          parentPropertyValToBeSensitive="0">
    <DefaultValue value="1"/>
    <LowerBound value="1"/>
    <UpperBound value="2"/>
</Property>


<Property name="Relative Permittivity"
          neutralName="IsotropicLinearPermittivity"
          valueType="scalarField"
          scaleFactor="false"
          parentProperty="PermittivityType"
          parentPropertyValToBeSensitive="1">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="2">
        <Domain type="&DomainConstant;"/>
        <Domain type="&DomainTemperature;"/>
    </FieldDefn>
</Property>




<Property name="Nonlinear Permittivity"
          neutralName="NonLinearPermittivity"
          valueType="scalarField"
          valueSubtype="compact"
          scaleFactor="false"
          parentProperty="PermittivityType"
          parentPropertyValToBeSensitive="2">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain Name="temperature,electric field strength"
                autocreate="true"
                type="&DomainUser;"
                nVariables="2">
            <Variable Name="temperature"
                      Measure="&MeasureTemperature;"/>
            <Variable Name="electric field strength"
                      Measure="&MeasureElectricFieldStrength;"/>
        </Domain>
    </FieldDefn>
</Property>


<Property name="Relative Permittivity"
          neutralName="ComplexElectricPermittivity"
          valueType="complexField"
          scaleFactor="false"
          parentProperty="HighFrequencyDielectricModel"
          parentPropertyValToBeSensitive="1,5">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="2">
        <Domain type="&DomainConstant;"/>
        <Domain type="&DomainFrequency;"/>
    </FieldDefn>
</Property>

<Property name="Relative Permittivity at Infinity"
