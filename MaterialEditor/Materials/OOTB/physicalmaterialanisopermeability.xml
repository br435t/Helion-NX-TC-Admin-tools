                     NeutralName="RelativePermeabilityXZReal"
                     LowerBound="&valueZero;"/>
        <DepVariable Measure="&MeasureUnitLess;"
                     Name="Permeability XZ (imaginary)"
                     DisplayName="XZ (imaginary)"
                     NeutralName="RelativePermeabilityXZImaginary"
                     LowerBound="&valueZero;"/>
        <DepVariable Measure="&MeasureUnitLess;"
                     Name="Permeability YY (real)"
