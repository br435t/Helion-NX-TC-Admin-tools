<Property name="Load Curve ID for Longitudinal Tensile Strength (LCXT)"
          neutralName="LoadCurveIDLongitudinalTensileLCXT"
          valueType="scalarField"
          valueSubtype="&scalarFieldCompactDisplay;"
          Dimensions="&MeasureStress;"
          scaleFactor="false">
    <DefaultValue value="&valueEmpty;"/>
    <FieldDefn nDomains="1">
        <Domain Name="Strain Rate"
                nVariables="1">
            <Variable Name="Strain Rate"
                      Measure="&MeasureCoefficientPerTime;"/>
        </Domain>
    </FieldDefn>
</Property>

