<!--
          .===============.
          |PropertyField  |
          |               |
          .v============v=.
           |            |
           |            |
     .=====v======.     |
     |DepDomain   |     |  The "DepDomain" is used to define the field's dependent domain
     |            |     |
     .==v=========.     |  If the specified domain has measures, then variable validation will
        |               |  simply check that it is a valid domain.  No order is specified or
        |               |  names for validation, so it is NOT recommended unless all variables
        |               |  in the domain have unique measures; otherwise it will be impossible
        |               |  for formatters to differentiate the variables to map to output=
     .==v=========.     |
     |DepVariable |     |  If the specified domain has variables, then the specified variables
     |            |     |  must constitute the valid measures for the domain and variables on
     .==v=========.     |  the selected field should be mapped in order.
        |               |
        |               |  If the specified variables have names, the order is irrelevant, and
     .=(*)=========.    |  the mapping will be done based on name AND measure.
     |ExcludeValue |    |
     |             |    |
     .=============.    |
                     .==v=========.
                     |FieldDefn   |
                     |            |
                     .==v=========.
                        |
                       .=. See FieldDefn for info on independent domain spec=
-->
<!ELEMENT PropertyField (DepDomain, FieldDefn)>
<!ATTLIST PropertyField
    name CDATA #REQUIRED
    visible (true | false) "true"
    editable (true | false) "true"
    neutralName CDATA #REQUIRED
    valueType (generalField | vectorField) "generalField"
    inferredSelection (true | false) "false"
    plot (true | false) "true"
    scaleFactor (true | false) "true"
    valueSubtype CDATA ""
    icon CDATA #IMPLIED
    valueChoices CDATA #IMPLIED
    valueLabel CDATA #IMPLIED
    valueToolTip CDATA #IMPLIED
    Dimensions ( -2 ) "-2"
    Type (default) "default"
    parentProperty CDATA ""
    parentPropertyValToBeSensitive CDATA "0"
    propertyVisibleOrSensitive ( visible | sensitive ) "visible"
    menuAttachProp CDATA ""
    attachType ( attachRight ) "attachRight"
    retainValue ( true | false ) "false"
    action CDATA ""
    scalarOnly ( true | false ) "false"
    noObjectSelectedLabel CDATA "None"
    allowUnspecifiedValue ( true | false ) "true"
    relatedRegionTargetSets CDATA ""

>
