<Property name="Progressive Failure Model"
          solPrefixName="NonPhysicalProp_Abaqus_"
          solSuffixName="ProgressiveFailureTHEORY"
          editable="true"
          valueType="enum"
          valueChoices="&Choice;None=0&Choice;MCT - UD Fibers=1"
          Dimensions="&MeasureUnitLess;"
          scaleFactor="false">
    <DefaultValue value="&valueZero;"/>
    <LowerBound value="0"
                inclusive="true"/>
    <UpperBound value="1"
                inclusive="true"/>
</Property>

