<Property name="Dynamic Viscosity Control"
          neutralName="DynamicViscosityControl"
          valueType="enum"
          valueChoices="&Choice;Constant or Temperature=0&Choice;Temperature and Pressure=1;"
          Dimensions="&MeasureUnitLess;"
          parentProperty="&Choice;MaterialType"
          parentPropertyValToBeSensitive="&Choice;&MaterialTypeISOTROPIC;,&MaterialTypeFLUID;,&MaterialTypeANISOTROPIC;,&MaterialTypeCOMPOUNDISOTROPIC;,&MaterialTypeLOWDENSITYFOAM;,&MaterialTypeHONEYCOMB;">
    <DefaultValue value= "&valueZero;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="1"
                inclusive="true"/>
</Property>

<Property name="Pressure Cutoff (PC)"
          neutralName="PressureCutoff"
          valueType="float"
          Dimensions="&MeasureForcePerArea;"
          scaleFactor="false" 
          parentProperty="DynamicViscosityControl"
          parentPropertyValToBeSensitive="0">
    <DefaultValue value="&valueZero;"/>
    <UpperBound value="&valueZero;"
                inclusive="true"/>
</Property>

<Property name="Dynamic Viscosity"
          neutralName="DynamicVisc"
          valueType="scalarField"
          Dimensions="&MeasureDynamicViscosity;"
          scaleFactor="false" 
          parentProperty="DynamicViscosityControl"
          parentPropertyValToBeSensitive="0">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&minFloat;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="2">
        <Domain type="&DomainConstant;"/>
        <Domain type="&DomainTemperature;"
                nVariables="1">
            <Variable Measure="&MeasureTemperature;"/>
        </Domain>

    </FieldDefn>
</Property>

<Property name="Dynamic Viscosity"
          neutralName="DynamicViscTempPress"
          valueType="scalarField"
          valueSubtype="&scalarFieldCompactDisplay;"          
          Dimensions="&MeasureDynamicViscosity;"
          scaleFactor="false"
          parentProperty="DynamicViscosityControl"
          parentPropertyValToBeSensitive="1">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&minFloat;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain type="&DomainTemperature;"
                nVariables="1"
                hasSecondary="true">
            <Variable Measure="&MeasureTemperature;"/>
            <SecondaryDomain type ="&DomainPressure;"/>
        </Domain>
    </FieldDefn>
</Property>


