        <ReferenceProperty neutralName="TangentModulusE"/>
        <ReferenceProperty neutralName="MixedHardeningRatio"
                           defaultValue="0.0"/>
        <ReferenceProperty neutralName="StrainRateLevel"/>
        <ReferenceProperty neutralName="ExponentBValue"/>
