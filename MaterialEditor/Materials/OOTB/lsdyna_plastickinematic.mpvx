        <ReferenceProperty neutralName="MatlNonlinearityType"
                           valueChoices="&Choice;Elastoplastic: stress-total strain (MATS1/PLASTIC)=1;"
                           defaultValue="1"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="StrainRatedependency"
                           valueChoices="&Choice;Symonds and Cowper=0;"
                           defaultValue="0"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="HardeningRule"
                           valueChoices="&Choice;Mixed Hardening=3;"
                           defaultValue="3"
                           showProp="false"
                           lockProp="true"/>
        <ReferenceProperty neutralName="Yield"/>
        <ReferenceProperty neutralName="StressStrainFormatType"
                           displayName="Stress-Strain Format Type"
                           valueChoices="&Choice;Bilinear by Tangent Modulus (ETAN)=2;"
