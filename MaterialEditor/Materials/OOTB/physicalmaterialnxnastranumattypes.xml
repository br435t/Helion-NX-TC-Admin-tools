<Group label="Model Type">
    <Property name="Model Type"
              neutralName="NxNastranUMATModelType"
              valueType="enum"
              valueChoices="&Choice;None=-777777&Choice;User Defined Material=0&Choice;User Defined Creep=1">
      <DefaultValue value="-777777"/>
      <LowerBound value="-777777"
                  inclusive="true"/>
      <UpperBound value="2"
                  inclusive="true"/>
    </Property>

    <Property name="Threshold Strain (THRESH)"
              neutralName="NxNastranUMATCreepThresholdStrain"
              valueType="float"
              Dimensions="&MeasureStrain;"
              parentProperty="NxNastranUMATModelType"
              parentPropertyValToBeSensitive="1">
        <DefaultValue value="1.0e-12"/>
        <LowerBound value="&valueZero;"
                    inclusive="false"/>
    </Property>

    <Property name="Check Unit System"
              neutralName="NxNastranUMATCheckUnitSystem"
              valueType="enum"
              valueChoices="&Choice;No=0;&Choice;Yes=1;"
              Dimensions="&MeasureUnitLess;"
              parentProperty="NxNastranUMATModelType"
              parentPropertyValToBeSensitive="1">
        <DefaultValue value="0"/>
    </Property>

    <Property name="Units(Force)(Length)(Mass)"
              neutralName="NxNastranUMATForceLengthMassUnits"
              valueType="enum"
              parentProperty="NxNastranUMATCheckUnitSystem"
              parentPropertyValToBeSensitive="1"
              valueChoices="&Choice;(N)(m)(kg)=0;
                            &Choice;(lbf)(ft)(slug)=1;
                            &Choice;(kgf)(m)(kgf-s^2/m)=2;
                            &Choice;(poundal)(ft)(lbm)=3;
                            &Choice;(mN)(mm)(kg)=4;
                            &Choice;(cN)(cm)(kg)=5;
                            &Choice;(lbf)(in)(lbf-s^2/in)=6;
                            &Choice;(kgf)(mm)(kgf-s^2/mm)=7;
                            &Choice;(N)(mm)(tonne)=8">
        <DefaultValue value="0"/>
    </Property>
</Group>

