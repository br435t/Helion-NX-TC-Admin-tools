<Group label="Property Calculation">
    <Property name="Density Method"
              neutralName="DensityCalcMethod"
              editable="false"
              valueType="enum"
              valueChoices="&Choice;Voigt (Volume Based)=0&Choice;Reuss (Volume Fraction Based)=1&Choice;Voigt-Reuss-Hill Average=2&Choice;User Specified (reset to defaults)=3">
        <DefaultValue value="0"/>
    </Property>
    <Property name="Method"
              neutralName="GeneralCalcMethod"
              valueType="enum"
              valueChoices="&Choice;Voigt (Volume Based)=0&Choice;Reuss (Volume Fraction Based)=1&Choice;Voigt-Reuss-Hill Average=2&Choice;User Specified (reset to defaults)=3">
        <DefaultValue value="0"/>
    </Property>
    <Property name="Calculate Properties"
              neutralName="CalculateProperties"
              valueType="action"
              action="PartUI_ActionValue_MaterialCB__CalculateCompoundMatlProps"
              icon="calculate_properties">
