          parentProperty="&Choice;FrameType&Choice;FrameTypeJohnson"
          parentPropertyValToBeSensitive="&Choice;1&Choice;1,2">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
