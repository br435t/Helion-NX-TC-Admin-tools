<Property name="Porous Models"
      neutralName="PorousModels"
      valueType="enum"
      valueChoices="&Choice;Craggs=0;&Choice;Delany-Bazley-Miki=1;&Choice;Johnson-Champoux-Allard=2;">
    <DefaultValue value="0"/>
    <LowerBound value="0"/>
    <UpperBound value="2"/>
</Property>


&soundSpeed;

<Property name="Specific Heat Ratio"
          neutralName="SpecificHeatRatio"
          valueType="float"
          parentProperty="PorousModels"
          parentPropertyValToBeSensitive="2">
