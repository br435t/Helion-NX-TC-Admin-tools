<Property name="Cure Kinetic Model"
          neutralName="CureKineticModel"
          valueType="enum"
          valueChoices="&Choice;Samcef=0&Choice;Auto-Catalytic=1;&Choice;n-th Order=2;&Choice;Kamal and Sourour=3;&Choice;Lee, Chiu and Lin=4;&Choice;Lee, Loos and Springer=5&Choice;User-Defined Cure Kinetics=6">
