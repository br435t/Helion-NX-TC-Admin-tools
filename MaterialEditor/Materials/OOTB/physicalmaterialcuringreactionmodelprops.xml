    <LowerBound value="0"/>
    <UpperBound value="5"/>
</Property>

<Property name="Frequency of Reaction (freq)"
          neutralName="ReactionFrequency"
          parentProperty="CureKineticModel"
          parentPropertyValToBeSensitive="0,1,2,3,4,5"
          valueType="float"
          Dimensions="&MeasureFrequency;">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&minFloat;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
</Property>

