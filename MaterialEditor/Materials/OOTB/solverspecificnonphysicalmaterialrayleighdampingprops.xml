<Property name="Mass Proportional Damping Factor (ALPHA)"
            solPrefixName="NonPhysicalProp_Abaqus_"
            solSuffixName="AlphaDampingFactor"
            valueType="scalarField"
            Dimensions="&MeasureCoefficientPerTime;">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="false"/>
    <FieldDefn nDomains="2">
        <Domain type="&DomainConstant;"/>
        <Domain type="&DomainTemperature;"/>
    </FieldDefn>
</Property>

