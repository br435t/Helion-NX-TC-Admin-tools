<PropertyField name="Stress Life Data Field"
               neutralName="StressLifeDataField"
               parentProperty="StressLifeDataFormat"
               parentPropertyValToBeSensitive="1">
    <DepDomain nVariables="1"
               autocreate="true"
               type="&DomainUser;"
               Name="Stress Amplitude">
        <DepVariable Measure="&MeasureStress;"
                     Name="Stress Amplitude"
                     DisplayName="Stress Amplitude"/>
    </DepDomain>
    <FieldDefn nDomains="2">
        <Domain type="&DomainGeneral;"
                nVariables="1">
            <Variable Measure="&MeasureFatigueLife;"/>
        </Domain>
        <Domain type="&DomainTemperature;"
                hasSecondary="true">
            <SecondaryDomain type="&DomainGeneral;"
                             nVariables="1">
                <Variable Measure="&MeasureFatigueLife;"/>
            </SecondaryDomain>
        </Domain>
    </FieldDefn>
</PropertyField>

