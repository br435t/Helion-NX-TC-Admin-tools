
<!-- Creep Tab                                                                  -->
<!-- Norton-Bailey (A * ( SIGMA^n ) * ( time^m ))                               -->
<!-- Kelvin-Maxwell Rheological Model (C1 * ( 1 - e^(-C2 * time )) + C3 * time) -->
<Property name=""
            neutralName="CreepFormulation"
            valueType="enum"
            valueChoices="&Choice;##397None=0;
                        &Choice;O.R.N.L viscoplastic material (CREEP/TYPE 111-222)=2;
                        &Choice;Time Hardening (Norton-Bailey) Power Law (CREEP/TYPE 300)=1;
                        &Choice;Kelvin-Maxwell, uniaxial creep recovery test, Tabular Input (CREEP/Table)=3;
                        &Choice;Strain Hardening Power Law=4;
                        &Choice;Norton-Bailey in Time or Strain Hardening, Temperature-Dependent (MATCRP/Type 301)=5;
                        &Choice;Strain Hardening Creep (MVPLAS/Law STRNHARD)=6;
                        &Choice;Norton Creep (MVPLAS/Law NORTON)=7;
                        &Choice;Generalized Garofalo Creep (MVPLAS/Law GENGAROF)=8;
                        &Choice;Norton-Bailey in Time Hardening Creep (MVPLAS/Law TIMEHARD)=9;
                        &Choice;User Creep (MVPLAS/Law USER + MUCRP)=10;
                        &Choice;Generalized Blackburn Creep=11;"
            valueLabel="&Below; &ValueLabelChoice;A * ( SIGMA^n ) * ( time^m )&ValueLabelChoice;C1 * ( 1 - e^(-C2 * time )) + C3 * time&ValueLabelChoice; &ValueLabelChoice;A * ( SIGMA^n ) * ( time^m )&ValueLabelChoice;epsilon_cr = A * sigma^B * t^D, Time Hardening: d(epsilon_cr)/dt = A * D * sigma^B * t^(D-1), Strain Hardening: d(epsilon_cr)/dt = D * [A * sigma^B * epsilon_cr^(D-1)]^(1/D)&ValueLabelChoice;d(Eq.Cr.Strain)/dt = C1 * Eq.Stress^C2 * Eq.Cr.Strain^C3 * EXP(-C4/T)&ValueLabelChoice;d(Eq.Cr.Strain)/dt = C1 * Eq.Stress^C2 * EXP(-C4/T)&ValueLabelChoice;d(Eq.Cr.Strain)/dt = C1 * [ SINH( C2 * Eq.Stress) ]^C3 * EXP(-C4/T)&ValueLabelChoice;Eq.Cr.Strain = A * Eq.Stress^B * t^D -> d(Eq.Cr.Strain)/dt = A * D * Eq.Stress^B * t^(D-1)&ValueLabelChoice; &ValueLabelChoice;d(Eq.Cr.Strain)/dt = C1 * (1 - e^(C2 * time)) + (C3 * time)"
            Dimensions="&MeasureUnitLess;">
    <DefaultValue value="0"/>
</Property>
<Property name="Creep Reference Temperature"
            neutralName="CreepReferenceTemperature"
            valueType="float"
            Dimensions="&MeasureTemperature;"
            parentProperty="CreepFormulation"
            parentPropertyValToBeSensitive="1,2,3,4,11">
