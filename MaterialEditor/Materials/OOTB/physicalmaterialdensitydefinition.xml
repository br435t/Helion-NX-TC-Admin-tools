<Property name="Mass Density (RHO)"
          neutralName="MassDensityTempPress"
          valueType="scalarField"
          valueSubtype="&scalarFieldCompactDisplay;"          
          Dimensions="&MeasureMassDensity;"
          scaleFactor="false"
          allowUnspecifiedValue="false"
          parentProperty="DensityControl"
          parentPropertyValToBeSensitive="2">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain type="&DomainTemperature;"
                nVariables="1"
                hasSecondary="true">
