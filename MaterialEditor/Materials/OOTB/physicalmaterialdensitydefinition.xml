<Property name="Density Control"
          neutralName="DensityControl"
          valueType="enum"
          valueChoices="&Choice;Constant or Temperature or Frequency=0&Choice;Direct Complex=1&Choice;Temperature and Pressure=2">
    <DefaultValue value= "0"/>
    <LowerBound value="0"
                inclusive="true"/>
    <UpperBound value="2"
                inclusive="true"/>
</Property>

<Property name="Mass Density (RHO)"
          neutralName="MassDensity"
          valueType="scalarField"
          Dimensions="&MeasureMassDensity;"
          scaleFactor="true"
          allowUnspecifiedValue="false"
          parentProperty="DensityControl"
          parentPropertyValToBeSensitive="0">
    <DefaultValue value="&valueZero;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="3">
        <Domain type="&DomainConstant;"/>
        <Domain type="&DomainTemperature;"
                nVariables="1">
            <Variable Measure="&MeasureTemperature;"/>
        </Domain>
        <Domain type="&DomainFrequency;"
                nVariables="1">
            <Variable Measure="&MeasureFrequency;"/>
        </Domain>
    </FieldDefn>
</Property>

<Property name="Mass Density (RHO)"
          neutralName="MassDensityConstant"
          valueType="scalarField"
          Dimensions="&MeasureMassDensity;"
          scaleFactor="false"
          parentProperty="ElasticDependencyControl"
          parentPropertyValToBeSensitive="3,4,5,6">
    <DefaultValue value="&valueZero;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain type="&DomainConstant;"/>
    </FieldDefn>
</Property>

<Property name="Temperature Dependent Mass Density (RHO)"
