>
<!ELEMENT LowerBound EMPTY>
<!ATTLIST LowerBound
    value CDATA #REQUIRED
    inclusive (true | false) "false"
>
<!ELEMENT ExcludeValue EMPTY>
<!ATTLIST ExcludeValue
    value CDATA #REQUIRED
>
<!ELEMENT ReferenceFilterClass EMPTY>
<!ATTLIST ReferenceFilterClass
    name CDATA #IMPLIED
