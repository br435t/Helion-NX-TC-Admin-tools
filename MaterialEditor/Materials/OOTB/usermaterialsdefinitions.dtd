<!ELEMENT DefaultValue EMPTY>
<!ATTLIST DefaultValue
    value CDATA #REQUIRED
>
<!ELEMENT UpperBound EMPTY>
<!ATTLIST UpperBound
    value CDATA #REQUIRED
