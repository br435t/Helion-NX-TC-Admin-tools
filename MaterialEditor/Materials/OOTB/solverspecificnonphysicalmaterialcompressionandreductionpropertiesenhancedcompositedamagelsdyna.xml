                inclusive="true"/>
</Property>

<Property name="Material Softening Reduction (SOFT)"
        solPrefixName="NonPhysicalProp_LSDyna_"
        solSuffixName="SOFT"
        valueType="float"
        Dimensions="&MeasureUnitLess;">
