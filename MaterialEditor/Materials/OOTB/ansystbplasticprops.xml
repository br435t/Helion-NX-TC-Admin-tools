<Property name="Static Recovery Coefficient"
          neutralName="AnsysStaticRecoveryCoeff"
          valueType="scalarField"
          Dimensions="&MeasureCoefficientPerTime;"
          parentProperty="ElasticDependencyControl"
          parentPropertyValToBeSensitive="0,3"
          scaleFactor="false">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain type="&DomainConstant;"/>
    </FieldDefn>
</Property>
<Property name="Temperature Dependent Static Recovery Coefficient"
          neutralName="AnsysStaticRecoveryCoeffTemperature"
          valueType="scalarField"
          valueSubtype="&scalarFieldCompactDisplay;"
          Dimensions="&MeasureCoefficientPerTime;"
          parentProperty="ElasticDependencyControl"
          parentPropertyValToBeSensitive="0,4,6"
          scaleFactor="false">
    <DefaultValue value="&valueEmpty;"/>
    <LowerBound value="&valueZero;"
                inclusive="true"/>
    <UpperBound value="&maxFloat;"
                inclusive="true"/>
    <FieldDefn nDomains="1">
        <Domain type="&DomainTemperature;"
                nVariables="1">
            <Variable Measure="&MeasureTemperature;"/>
        </Domain>
    </FieldDefn>
</Property>

